# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID from the same page
DISCORD_CLIENT_ID=

# Optional: deploy slash commands to one guild for instant updates while testing
# Leave empty to deploy globally (can take up to 1 hour to propagate)
DISCORD_GUILD_ID=

# Optional: developer Discord for Megapithacus update notifications on new deploys
# Posts once per new version/commit (tracked in data/deploy-notify.json)
DEVELOPER_GUILD_ID=
DEVELOPER_CHANNEL_ID=

# Optional: custom embed icon URL (defaults to assets/megapithacus-logo.png
# uploaded via DEVELOPER_CHANNEL_ID, then bot avatar)
# BRAND_ICON_URL=https://example.com/icon.png

# Optional identity overrides (otherwise: GITHUB_SHA → PACK_VERSION file → package.json version)
# GITHUB_SHA=
# DEPLOY_SHA=
# PACK_VERSION=

# Cybrancee / Pterodactyl: root index.js pulls this GitHub branch on start, then boots.
# Auto-enabled when P_SERVER_UUID is set or cwd is /home/container. Set to 0 to disable.
# MEGAPITHACUS_GIT_SYNC=1
# MEGAPITHACUS_GIT_REPO=LoSTxSteel/megapithacus
# MEGAPITHACUS_GIT_BRANCH=cursor/admin-pay-board
# Required if the GitHub repo is private:
# MEGAPITHACUS_GIT_TOKEN=

# Nitrado tokens are added per Discord server in /management → Server Setup

# Optional: OpenXBL API key for Gamerscore Detection (Xbox profile lookups)
# Free key: https://xbl.io — without this, joins are fail-open (logged, not punished)
# OPENXBL_API_KEY=
# Alias also accepted:
# XBOX_API_KEY=

# Optional PayPal REST credentials for the main receiving account
# Prefer setting these in /donatemanage → Configure PayPal (per server).
# App needs Transaction Search scope enabled.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=live

# Optional Stripe secret key for the receiving account
# Prefer /donatemanage → Configure Stripe (per server).
# STRIPE_SECRET_KEY=sk_live_...
